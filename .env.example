# Copy to /opt/swaps/.env and fill in. NEVER commit the real .env.

# Flask session signing key. Generate: venv/bin/python tools.py gen-secrets
SECRET_KEY=CHANGE_ME_LONG_RANDOM

# Server-side pepper mixed into every PIN before hashing. Generate with
# gen-secrets. WARNING: changing this invalidates every stored PIN.
PIN_PEPPER=CHANGE_ME_LONG_RANDOM

# argon2id hash of the admin password. Generate:
# venv/bin/python tools.py hash-admin-password
ADMIN_PASSWORD_HASH=CHANGE_ME

# Resend (https://resend.com) API key for the verified
# pembrokeformalswaps.com sending domain. Paste the real key here on the VM.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX

MAIL_FROM=noreply@pembrokeformalswaps.com

# 'dev' logs emails to the journal instead of sending; 'live' sends via Resend.
EMAIL_MODE=dev

# Public base URL used in emailed links.
SITE_URL=https://pembrokeformalswaps.com

# Anthropic API key for the formal-swaps chatbot. Billed to YOUR Anthropic
# quota. Leave blank to disable the chatbot entirely (widget hidden). The bot
# uses the smallest model (claude-haiku-4-5) and is rate-limited per-IP and
# platform-wide (see swaps/security.py).
ANTHROPIC_API_KEY=
# Set to 0 to hide the chatbot even when a key is present.
CHATBOT_ENABLED=1

DB_PATH=/opt/swaps/data/swaps.db
LISTEN_PORT=8000

# 1 = read client IP from X-Forwarded-For (behind Caddy). 0 for bare local runs.
TRUST_PROXY=1
# 1 = session cookies require HTTPS (production). 0 only for local HTTP testing.
COOKIE_SECURE=1
